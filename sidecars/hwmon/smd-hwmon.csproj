<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional hardware-sensor helper for Scrub My Disks.
    Prints one JSON line of sensor readings every 2 seconds; exits when its stdin closes
    (the app closed the pipe or quit). Only started while the Hardware Health page is open.
    LibreHardwareMonitorLib is MPL-2.0 (used unmodified; license shipped next to the binary).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>smd-hwmon</AssemblyName>
    <RootNamespace>Smd.HwMon</RootNamespace>
    <Version>0.1.0</Version>
    <Company>Neverint</Company>
    <Product>Scrub My Disks</Product>
    <Copyright>Copyright (c) 2026 Neverint. MIT License.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
